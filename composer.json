{
    "name": "sendbyte/sendbyte-laravel",
    "description": "Laravel integration for the SendByte Africa transactional email API: a Mail driver, a direct API client, and signed webhook handling.",
    "keywords": ["laravel", "sendbyte", "email", "africa", "transactional-email", "webhooks"],
    "homepage": "https://sendbyte.africa",
    "license": "MIT",
    "type": "library",
    "require": {
        "php": "^8.1",
        "illuminate/support": "^10.0|^11.0|^12.0",
        "illuminate/mail": "^10.0|^11.0|^12.0",
        "illuminate/http": "^10.0|^11.0|^12.0",
        "symfony/mailer": "^6.2|^7.0",
        "symfony/mime": "^6.2|^7.0",
        "guzzlehttp/guzzle": "^7.5"
    },
    "require-dev": {
        "orchestra/testbench": "^8.0|^9.0|^10.0",
        "phpunit/phpunit": "^10.0|^11.0"
    },
    "autoload": {
        "psr-4": {
            "Sendbyte\\Laravel\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Sendbyte\\Laravel\\Tests\\": "tests/"
        }
    },
    "extra": {
        "laravel": {
            "providers": [
                "Sendbyte\\Laravel\\SendbyteServiceProvider"
            ],
            "aliases": {
                "Sendbyte": "Sendbyte\\Laravel\\Facades\\Sendbyte"
            }
        }
    },
    "minimum-stability": "stable",
    "prefer-stable": true
}
